{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["server/**/*.mjs", "shared/*.mjs", "scripts/**/*.mjs", "electron/**/*.js", "electron/**/*.cjs"]
}
