{
  "name": "bunkiten",
  "private": true,
  "version": "1.10.0",
  "description": "bunkiten（分岐点）—— LLM 互动 AVG（文字冒险/视觉小说）脚手架：Electron 桌面壳 + React 前端 + ACP 叙事引擎",
  "engines": {
    "node": ">=23.6"
  },
  "license": "MIT",
  "author": {
    "name": "Jackela"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jackela/bunkiten.git"
  },
  "homepage": "https://github.com/Jackela/bunkiten#readme",
  "bugs": {
    "url": "https://github.com/Jackela/bunkiten/issues"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k -n vite,electron \"vite\" \"electron .\"",
    "build": "tsc -b && vite build",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run --exclude \"tests/e2e*/**\"",
    "test:coverage": "vitest run --exclude \"tests/e2e*/**\" --coverage",
    "doctor": "node scripts/doctor.mjs",
    "providers:export": "node scripts/export-providers.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test -c playwright.ui.config.ts",
    "test:e2e:packaged": "playwright test -c playwright.electron.config.ts",
    "dist:win": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --x64 --publish never",
    "dist:mac:dir": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --dir --publish never"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "electron-updater": "^6.8.9",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "jsdom": "~30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
